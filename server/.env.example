# Salin ke .env lalu sesuaikan.
HOST=0.0.0.0
PORT=8000
# Beberapa key boleh dipisah koma (mis. satu untuk sandbox teman, satu untuk uji)
API_KEYS=ganti-dengan-key-acak
# Batasi ke origin web app teman bila sudah tahu, mis. http://192.168.1.20:5173
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=30

OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3.5:9b
VISION_MODEL=qwen3.5:9b
# Thinking aktif: reasoning masuk trace (step `reasoning`) + di-stream via SSE (`llm_delta`).
LLM_THINK=true
# Ekstraksi struk tanpa thinking (thinking vision memperlambat struk ±30 dtk → ±197 dtk)
VISION_THINK=false
# Qwen menyarankan ~0.6 saat thinking (hindari greedy)
LLM_TEMPERATURE=0.6
LLM_NUM_PREDICT=4096
LLM_READ_TIMEOUT_S=300
LLM_NUM_CTX=8192
AGENT_MAX_STEPS=6
AGENT_RUN_TIMEOUT_S=600
# Mesin orkestrasi agent: langgraph (graf LangGraph) | custom (loop lama). Kembali ke mesin lama: AGENT_ENGINE=custom
# lalu restart server. Checkpoint graf (konfirmasi/interrupt) di data/<nama DB>_langgraph.db (ubah lewat LANGGRAPH_CHECKPOINT_DB).
AGENT_ENGINE=langgraph

# Jalur ekstraksi struk: ocr_llm (OCR CPU -> LLM teks -> validasi -> fallback vision) | ocr_only (OCR + aturan, tanpa LLM)
# | vision (model vision membaca gambar, jalur lama)
RECEIPT_MODE=ocr_llm
RECEIPT_FALLBACK_VISION=true
# ocr_llm: coba parser aturan dulu; bila lolos validasi, LLM tidak dipanggil (±1 dtk)
RECEIPT_RULES_FIRST=true
OCR_MIN_CONF=0.80
OCR_MAX_SIDE=1600

WHISPER_MODEL=small
# auto = coba GPU dulu, fallback CPU
WHISPER_DEVICE=auto

# Fitur email (upload .eml + IMAP) dinonaktifkan pemilik: /v1/email dan /v1/email/imap/fetch menjawab 410.
# Kode tetap ada; set true lalu restart untuk mengembalikan.
EMAIL_ENABLED=false

# Konektor IMAP opsional (read-only, BODY.PEEK). Kosongkan untuk menonaktifkan.
# Untuk Gmail pakai App Password, bukan password akun.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SEARCH=UNSEEN
IMAP_MAX_MESSAGES=10
